{
  "name": "capacitor-hms-iap",
  "version": "0.1.0",
  "description": "Capacitor plugin for HUAWEI In-App Purchases (HMS IAP) on AppGallery",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Ramadian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raqolbi/capacitor-hms-iap.git"
  },
  "bugs": {
    "url": "https://github.com/raqolbi/capacitor-hms-iap/issues"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "huawei",
    "hms",
    "appgallery",
    "iap",
    "in-app-purchase",
    "billing"
  ],
  "scripts": {
    "verify": "npm run verify:android && npm run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build && npm test",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js}\"",
    "docgen": "docgen --api HmsIapPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended",
    "overrides": [
      {
        "files": [
          "src/definitions.ts"
        ],
        "rules": {
          "@typescript-eslint/array-type": "off"
        }
      }
    ]
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@capacitor/docgen": {
      "typescript": "$typescript"
    }
  }
}
